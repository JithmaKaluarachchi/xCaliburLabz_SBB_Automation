{
  "name": "sbb-oxygen-house-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript automation for SBB Oxygen House",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:functional": "playwright test --grep @functional",
    "test:nonfunctional": "playwright test --grep @nonfunctional",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:api": "playwright test --grep @api",
    "test:homepage": "playwright test tests/functional/home tests/nonfunctional/home --project=chromium --workers=1",
    "test:homepage:all": "playwright test tests/functional/home tests/nonfunctional/home --workers=1",
    "test:headed:homepage": "playwright test tests/functional/home --project=chromium --headed --workers=1",
    "test:shop": "playwright test tests/functional/shop tests/nonfunctional/shop --project=chromium --workers=1",
    "test:headed:shop": "playwright test tests/functional/shop --project=chromium --headed --workers=1",
    "test:shop:all": "playwright test tests/functional/shop tests/nonfunctional/shop --workers=1",
    "test:shop:visual": "playwright test tests/visual/shop.visual.spec.ts --project=chromium --workers=1",
    "test:shop:visual:update": "playwright test tests/visual/shop.visual.spec.ts --project=chromium --workers=1 --update-snapshots",
    "test:services": "playwright test tests/functional/services tests/nonfunctional/services --project=chromium --workers=1",
    "test:services:all": "playwright test tests/functional/services tests/nonfunctional/services --workers=1",
    "test:about-us": "playwright test tests/functional/about-us tests/nonfunctional/about-us --project=chromium --workers=1",
    "test:about-us:all": "playwright test tests/functional/about-us tests/nonfunctional/about-us --workers=1",
    "test:contact-us": "playwright test tests/functional/contact-us tests/nonfunctional/contact-us --project=chromium --workers=1",
    "test:contact-us:all": "playwright test tests/functional/contact-us tests/nonfunctional/contact-us --workers=1",
    "test:visual": "playwright test tests/visual --project=chromium",
    "test:visual:update": "playwright test tests/visual --project=chromium --update-snapshots",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:home:pdf": "python scripts/generate_owner_report.py",
    "report:owner:pdf": "python scripts/generate_owner_report.py",
    "report:shop:pdf": "python scripts/generate_shop_owner_report.py",
    "report:services:pdf": "python scripts/generate_services_owner_report.py",
    "report:about-us:pdf": "python scripts/generate_about_owner_report.py",
    "report:contact-us:pdf": "python scripts/generate_contact_owner_report.py",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.16.0",
    "dotenv": "^17.2.1",
    "typescript": "^5.8.3"
  }
}
